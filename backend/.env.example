# SMART Referral Central Backend Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./central_healthcare.db

# Operational Freshness Settings
OPERATIONAL_FRESHNESS_TTL_SECONDS=1800

# Security & CORS
ALLOWED_ORIGINS=*
API_BEARER_TOKEN_ADMIN=smart_referral_admin_token_prod_example
API_BEARER_TOKEN_DUTY=smart_referral_duty_officer_token_example
API_BEARER_TOKEN_CLINICIAN=smart_referral_clinician_token_example

# Google Gemini AI Integration (Server-side only, never client-exposed)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

